<Application x:Class="MealPlanner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#FCE9AB" SecondaryColor="#FCE9AB" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Sobrescribir el color de texto de botones principales para que sea negro -->
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="Black" />
            <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="Black" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
