<UserControl x:Class="MealPlanner.Views.PlanificacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:MealPlanner.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <local:BoolToColorConverter x:Key="BoolToColorConverter" />
        <local:BooleanToFontWeightConverter x:Key="BooleanToFontWeightConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txtMesAnio" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&lt;" Width="40" Margin="0,0,8,0" Click="btnMesAnterior_Click" />
                <Button Content="Hoy" Margin="0,0,8,0" Click="btnHoy_Click" />
                <Button Content="&gt;" Width="40" Click="btnMesSiguiente_Click" />
            </StackPanel>
        </Grid>

        <!-- Days of Week Header -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
            <TextBlock Text="Lun" FontWeight="Bold" TextAlignment="Center" />
            <TextBlock Text="Mar" FontWeight="Bold" TextAlignment="Center" />
            <TextBlock Text="Mié" FontWeight="Bold" TextAlignment="Center" />
            <TextBlock Text="Jue" FontWeight="Bold" TextAlignment="Center" />
            <TextBlock Text="Vie" FontWeight="Bold" TextAlignment="Center" />
            <TextBlock Text="Sáb" FontWeight="Bold" TextAlignment="Center" />
            <TextBlock Text="Dom" FontWeight="Bold" TextAlignment="Center" />
        </UniformGrid>

        <!-- Calendar Grid -->
        <ItemsControl Grid.Row="2" x:Name="icCalendario">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0.5" Background="Transparent"
                            MouseLeftButtonUp="BorderDia_MouseLeftButtonUp" Cursor="Hand" Margin="1">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding DiaNumero}" FontWeight="{Binding IsHoy, Converter={StaticResource BooleanToFontWeightConverter}}"
                                       Foreground="{Binding IsCurrentMonth, Converter={StaticResource BoolToColorConverter}}"
                                       HorizontalAlignment="Right" />

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Comidas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MaterialDesignPrimaryBrush}" CornerRadius="2" Margin="0,2,0,0" Padding="2">
                                            <TextBlock Text="{Binding InfoCorto}" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding InfoLargo}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>